# ===== Mihomo API =====
# Mihomo 容器在 docker 网络内的地址（与 mihomo 服务同网络时直接用服务名）
MIHOMO_API_URL=http://mihomo:9090
MIHOMO_SECRET=changeme

# ===== Probe Scheduler =====
# 探测周期（秒），建议 60
PROBE_INTERVAL=60
# 单次探测超时（毫秒）
PROBE_TIMEOUT=5000
# 探测目标 URL（一般用 gstatic）
PROBE_URL=https://www.gstatic.com/generate_204
# 并发探测的最大协程数
PROBE_CONCURRENCY=20
# 失败阈值（连续失败 N 次视为不可用）
PROBE_FAILURE_THRESHOLD=3

# ===== Aggregation =====
# 5 分钟聚合开启
AGG_5MIN_ENABLED=true
# 1 小时聚合开启
AGG_1H_ENABLED=true
# 原始数据保留天数
RETENTION_RAW_DAYS=7
# 5min 聚合保留天数
RETENTION_5MIN_DAYS=30

# ===== Auth =====
# 首次启动若 ADMIN_USERNAME 不存在则用此密码建账号（之后修改请改数据库）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# JWT 密钥（生产务必改成 32 字节随机串）
JWT_SECRET=please-change-me-to-a-random-32-byte-string
JWT_EXPIRES_HOURS=24

# ===== Server =====
HOST=0.0.0.0
PORT=19001
TZ=Asia/Shanghai

# ===== Demo 模式（本地无 mihomo 时开启，会注入假节点和模拟延迟） =====
DEMO_MODE=true